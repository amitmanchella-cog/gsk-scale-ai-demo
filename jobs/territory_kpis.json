{
  "name": "territory_kpis_weekly",
  "description": "UC1 - weekly territory KPIs (visits, follow-ups, sales per territory+week). Shown for the demo, not executed.",
  "tags": {
    "use_case": "UC1",
    "owner": "field-force-data-eng",
    "environment": "demo"
  },
  "email_notifications": {
    "on_failure": ["data-eng-oncall@example.com"],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [{"id": "<slack-webhook-destination-id>"}]
  },
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 ? * MON",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "git_source": {
    "git_url": "https://github.com/amitmanchella-cog/gsk-scale-ai-demo",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "build_territory_kpis",
      "description": "extract -> transform -> data-quality checks -> load (Parquet)",
      "spark_python_task": {
        "python_file": "pipelines/territory_kpis/job.py",
        "source": "GIT",
        "parameters": [
          "--input-dir", "/Volumes/field_force/raw/parquet",
          "--output", "/Volumes/field_force/curated/territory_kpis.parquet",
          "--min-rows", "100",
          "--max-rows", "5000"
        ]
      },
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1,
        "autotermination_minutes": 15,
        "spark_conf": {
          "spark.sql.session.timeZone": "UTC",
          "spark.sql.shuffle.partitions": "8"
        },
        "custom_tags": {"use_case": "UC1"}
      },
      "timeout_seconds": 2700,
      "max_retries": 1,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": false
    },
    {
      "task_key": "parity_check",
      "description": "Optional guard-rail: compare the fresh output with the frozen notebook output",
      "depends_on": [{"task_key": "build_territory_kpis"}],
      "spark_python_task": {
        "python_file": "pipelines/territory_kpis/parity.py",
        "source": "GIT",
        "parameters": ["--output", "/Volumes/field_force/curated/territory_kpis.parquet"]
      },
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1,
        "autotermination_minutes": 15
      },
      "timeout_seconds": 900
    }
  ],
  "format": "MULTI_TASK"
}
